# =============================================================================
# Library Book Collection — Environment Configuration
# =============================================================================
#
# This file documents every environment variable the application needs.
# Use it as the source of truth for:
#
#   1. Local development — copy to .env and fill in values.
#   2. CI/CD variables   — create matching variables in GitLab
#      (Settings → CI/CD → Variables).
#
# Do NOT commit real .env files or any file containing actual secrets.
# =============================================================================


# =============================================================================
# REQUIRED VARIABLES
# =============================================================================
# These variables must be set for the application to start.  The server will
# refuse to boot if SESSION_SECRET is missing, and will log errors for any
# others that are absent.

# Initial admin username — used to seed the first admin user on startup.
# The user is created only once; subsequent starts ignore this value.
ADMIN_USERNAME=admin

# Initial admin password — bcrypt-hashed on first use, then stored in the
# database.  Must be at least 8 characters.
ADMIN_PASSWORD=

# Secret key used for signing session cookies.  Must be at least 32 random
# characters.  Rotate it if you suspect a leak (sessions will be invalidated).
SESSION_SECRET=

# Shared guest password — guests log in with this value.  Stored as a bcrypt
# hash in the database.  Change it by updating the variable and restarting the
# container.
GUEST_PASSWORD=


# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================
# These variables have sensible defaults.  Override them only when you need
# to change behaviour.

# HTTP listen port (default: 8080).  Exposed to the reverse proxy.
PORT=8080

# SQLite database file path (default: /app/data/library.db).
# When using Docker this should point into the mounted volume.
DATABASE_PATH=/app/data/library.db

# Logging level — one of debug, info, warn, error (default: info).
LOG_LEVEL=info

# Litestream AWS credentials — configure only if you want automatic S3
# backups of the SQLite database.  See compose.yaml for how these are wired
# into the container.
#
# LITESTREAM_AWS_ACCESS_KEY_ID=
# LITESTREAM_AWS_SECRET_ACCESS_KEY=
# LITESTREAM_REPOSITORY=


# =============================================================================
# INFRASTRUCTURE VARIABLES
# =============================================================================
# These are set by the reverse-proxy / TLS termination layer, not by the
# application itself.  Documented here for completeness.

# Hostname the reverse proxy will forward requests to (nginx / traefik).
VIRTUAL_HOST=library.rcsmaine.com

# Hostname used for Let's Encrypt certificate provisioning.
LETSENCRYPT_HOST=library.rcsmaine.com


# =============================================================================
# LOCAL DEVELOPMENT
# =============================================================================
# To run the app locally with Docker Compose:
#
#   1. Copy this file and fill in the required values:
#
#        cp .env.example .env
#        $EDITOR .env
#
#   2. Start the stack:
#
#        docker compose up -d
#
# compose.yaml reads .env automatically via the env_file directive.  Any
# variable defined in .env will be injected into the container at runtime.
#
# For direct (non-Docker) development, export the variables in your shell
# or use a tool like direnv:
#
#   cd backend
#   direnv allow
#   go run .
#
# =============================================================================


# =============================================================================
# CI/CD VARIABLES
# =============================================================================
# All secrets and configuration values used by the GitLab CI/CD pipeline
# must be added as CI/CD variables in the project settings.
#
#   GitLab → Settings → CI/CD → Variables → Add variable
#
# For every variable listed above under "REQUIRED" and "OPTIONAL" sections,
# create a matching CI/CD variable with the same name.
#
# IMPORTANT: Mark the following as both "Masked" and "Protected":
#
#   • ADMIN_PASSWORD
#   • SESSION_SECRET
#   • GUEST_PASSWORD
#   • LITESTREAM_AWS_ACCESS_KEY_ID
#   • LITESTREAM_AWS_SECRET_ACCESS_KEY
#
# Why?
#   — Masked:   prevents the value from appearing in pipeline logs.
#   — Protected: restricts the variable to protected branches/tags only
#                 (e.g. main), so untrusted merge requests can't read it.
#
# Example: adding SESSION_SECRET in the GitLab UI
#
#   1. Navigate to Settings → CI/CD → Variables
#   2. Click "Add variable"
#   3. Key:   SESSION_SECRET
#   4. Value: (paste your 32+ character secret)
#   5. Type:   File  (or Variable — File is preferred for long secrets)
#   6. ☑ Masked
#   7. ☑ Protected
#   8. ☑ Expanding (optional — exposes to child pipelines)
#   9. Click "Save"
#
# This .env.example file is the source of truth for which variables to create.
# If a variable appears here, it should also exist in CI/CD settings.
#
# =============================================================================
